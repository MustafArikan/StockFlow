# =====================================================================
# StockFlow — environment template / ortam değişkeni şablonu
# Copy to `.env` and replace every placeholder before running.
# `.env` olarak kopyalayın ve çalıştırmadan önce tüm değerleri değiştirin.
# =====================================================================

# --- DATABASE / VERİTABANI ---
MSSQL_SA_PASSWORD=ChangeMe_Strong_Password_123!
DB_PORT=1433

# --- PORTS / PORTLAR ---
BACKEND_PORT=5000
FRONTEND_PORT=3000

# --- .NET ENVIRONMENT / ORTAM ---
# Development | Production
ASPNETCORE_ENVIRONMENT=Development

# --- SECURITY & JWT / GÜVENLİK ---
# Minimum 32 bytes. Required in Production / Production'da zorunludur.
JWT_SECRET_KEY=ChangeMe_A_Very_Long_And_Secure_Secret_Key_32_Bytes_Minimum!
JWT_ISSUER=StockFlowBackend
JWT_AUDIENCE=StockFlowFrontend

# --- SMTP (e-mail verification & password reset) ---
# Leave empty to disable outgoing mail / boş bırakılırsa e-posta gönderilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- MONITORING (Prometheus & Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_Grafana_Password_123!
